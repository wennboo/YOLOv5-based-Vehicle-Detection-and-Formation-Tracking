
<robot name="my_depthcamera" xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:property name="camera_length" value="0.01" /> 
    <xacro:property name="camera_width" value="0.025" /> 
    <xacro:property name="camera_height" value="0.025" /> 
    <xacro:property name="camera_x" value="${base_link_x / 2}" />
    <xacro:property name="camera_y" value="${camera_width / 2}" />
    <xacro:property name="camera_z" value="${base_link_z / 2 + camera_height / 2}" />
    <xacro:property name="camera_m" value="0.01" />

    <link name="follower_depthcamera">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <material name="red">
                <color rgba="1.0 0.0 0.0 0.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
        </collision>
        <xacro:Box_inertial_matrix m="${camera_m}" l="${camera_length}" w="${camera_width}" h="${camera_height}" />
    </link>

    <joint name="depthcamera2base_link" type="fixed">
        <parent link="follower_base_link" />
        <child link="follower_depthcamera" />
        <origin xyz="${camera_x} ${camera_y} ${camera_z}" />
    </joint>
    <gazebo reference="follower_depthcamera">
        <material>Gazebo/Red</material>
    </gazebo>
</robot>
