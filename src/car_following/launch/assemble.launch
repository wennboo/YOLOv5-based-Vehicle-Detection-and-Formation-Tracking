     <!-- <node pkg="car_following" type="mpc_follower_smooth.py" name="mpc_follower_smooth" /> -->

    <!-- 发布相对位置坐标系关系 -->
    <node pkg="car_following" type="tf_world_leader" name="tf_world_leader" />

    <node pkg="car_following" type="tf_world_follower" name="tf_world_follower" />
    
