<launch>
    
    <!-- publish pose made by keyboard -->
    <node pkg="car_following" type="pose_pub" name="pose_pub" />
    <!-- generate follower in world cordinate -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="static_transform_publisher" args="0 0 0 0 0 0 /world /follower"/>
    <!-- generate the following algorithm -->
    <node pkg="car_following" type="follower" name="follower" />
    <!-- start rviz node -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find car_following)/rviz/observer.rviz"/>
</launch>